{
	"name": "@melian-agent/core",
	"version": "0.0.0",
	"description": "Harness-free review domain: findings, lenses, checks, configuration, standards, knowledge",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melian-agent/melian.git",
		"directory": "packages/core"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@melian-agent/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"lenses",
		"README.md"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist tsconfig.build.tsbuildinfo",
		"test": "vitest --run --root ../.. --passWithNoTests packages/core/"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"typebox": "1.3.27",
		"yaml": "2.9.1"
	}
}
