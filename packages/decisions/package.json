{
	"name": "@melian-agent/decisions",
	"version": "0.0.0",
	"description": "Decision-model port and adapters",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melian-agent/melian.git",
		"directory": "packages/decisions"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@melian-agent/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist ../../.tsbuild/decisions.tsbuildinfo",
		"prepack": "npm run build",
		"postpack": "npm run clean",
		"test": "vitest --run --root ../.. --passWithNoTests packages/decisions/"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@melian-agent/core": "*",
		"@types/mdast": "4.0.4",
		"github-slugger": "2.0.0",
		"mdast-util-definitions": "6.0.0",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-frontmatter": "2.0.1",
		"mdast-util-to-string": "4.0.0",
		"micromark-extension-frontmatter": "2.0.0",
		"typebox": "1.3.27",
		"unist-util-visit": "5.1.0"
	}
}
