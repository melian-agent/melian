{
	"name": "@melian-agent/cli",
	"version": "0.0.0",
	"description": "The melian command",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melian-agent/melian.git",
		"directory": "packages/cli"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@melian-agent/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist tsconfig.build.tsbuildinfo",
		"test": "vitest --run --root ../.. --passWithNoTests packages/cli/"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
