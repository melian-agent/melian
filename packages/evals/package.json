{
	"name": "@melian-agent/evals",
	"version": "0.0.0",
	"description": "Golden corpus and scoring for Melian reviews",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/melian-agent/melian.git",
		"directory": "packages/evals"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@melian-agent/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"clean": "rm -rf dist ../../.tsbuild/evals.tsbuildinfo",
		"prepack": "npm run build",
		"postpack": "npm run clean",
		"test": "vitest --run --root ../.. --passWithNoTests packages/evals/",
		"eval:live": "node --conditions=@melian-agent/source src/live.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@melian-agent/core": "*",
		"@melian-agent/pipeline": "*",
		"typebox": "1.3.27"
	}
}
