{
	"name": "melian-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "biome check --write --error-on-warnings . && node scripts/check-pinned-deps.mjs && node scripts/check-release-age.mjs && tsc --noEmit && npm audit --audit-level=high && vitest --run",
		"lint": "biome check --error-on-warnings .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"build": "tsc -b tsconfig.build.json",
		"pack": "node scripts/pack.mjs",
		"clean": "npm run clean --workspaces --if-present && rm -rf .tsbuild"
	},
	"engines": {
		"node": ">=22.19.0",
		"npm": ">=11.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "22.20.4",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.3"
	}
}
