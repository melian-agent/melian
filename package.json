{
	"name": "melian-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"check": "biome check --write --error-on-warnings . && node scripts/check-pinned-deps.mjs && node scripts/check-release-age.mjs && node scripts/check-tools.mjs && node scripts/check-inventories.mjs && tsc --noEmit && node scripts/check-audit.mjs && vitest --run",
		"lint": "biome check --error-on-warnings .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --run",
		"build": "tsc -b tsconfig.build.json",
		"pack": "node scripts/pack.mjs",
		"clean": "npm run clean --workspaces --if-present && rm -rf .tsbuild",
		"code-hashes": "node scripts/code-hashes.mjs --write"
	},
	"engines": {
		"node": ">=22.19.0",
		"npm": ">=11.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@stryker-mutator/core": "10.0.0",
		"@stryker-mutator/vitest-runner": "10.0.0",
		"@types/node": "22.20.4",
		"@types/semver": "7.8.0",
		"mdast-util-from-markdown": "2.1.0",
		"mdast-util-to-markdown": "2.2.0",
		"mdast-util-to-string": "4.0.0",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.3"
	},
	"overrides": {
		"@anthropic-ai/sandbox-runtime": {
			"zod": "4.6.7"
		}
	}
}
