{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "error",
				"useNodejsImportProtocol": "off"
			},
			"suspicious": {
				"noControlCharactersInRegex": "off",
				"noEmptyInterface": "off"
			}
		}
	},
	"plugins": [
		{
			"path": "./biome/free-domain-function.grit",
			"includes": ["**/packages/*/src/**"]
		},
		{
			"path": "./biome/literal-emoji.grit"
		}
	],
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 120
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.mts",
			"**/*.cts",
			"**/*.js",
			"**/*.jsx",
			"**/*.mjs",
			"**/*.cjs",
			"!**/node_modules/**/*",
			"!**/dist/**/*",
			"!packages/evals/goldens/**/*",
			"!packages/evals/triage/**/*",
			"!packages/evals/verifier/**/*"
		]
	}
}
