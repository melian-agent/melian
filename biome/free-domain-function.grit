language js

JsFunctionDeclaration(id = $name, parameters = JsParameters(items = [$first, ...])) where {
	$first <: JsFormalParameter(type_annotation = TsTypeAnnotation(ty = $type)),
	$type <: or {
		r"(?:readonly\s+)?(?:Finding|StoredFinding|ResolvedFinding|Defect|Verdict|Manifest|Lens|Revision|Changeset)(?:\[\])?",
		r"ReadonlyArray<\s*(?:Finding|StoredFinding|ResolvedFinding|Defect|Verdict|Manifest|Lens|Revision|Changeset)\s*>"
	},
	register_diagnostic(
		span = $name,
		message = "Behaviour belongs to the object it is about: a function whose first parameter is a domain object is a method of that class, as AGENTS.md says."
	)
}
