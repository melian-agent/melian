language js

or {
	JsFunctionDeclaration(id = $name, parameters = JsParameters(items = [$first, ...])),
	JsFunctionExportDefaultDeclaration(parameters = JsParameters(items = [$first, ...])) as $name
} where {
	$first <: JsFormalParameter(type_annotation = TsTypeAnnotation(ty = $type)),
	$type <: or {
		r"(?:readonly\s+)?(?:Finding|ResolvedFinding|Defect|Verdict|Manifest|Lens|Revision|Changeset|Comparison|ExternalFinding)(?:\[\])?",
		r"ReadonlyArray<\s*(?:Finding|ResolvedFinding|Defect|Verdict|Manifest|Lens|Revision|Changeset|Comparison|ExternalFinding)\s*>"
	},
	register_diagnostic(
		span = $name,
		message = "Behaviour belongs to the object it is about: make a function whose first parameter is a domain object a method on that object's class, or on this package's own class that adapts it, as AGENTS.md says."
	)
}
