(version 1)
; A seatbelt profile for running Codex in full-access mode under a sandbox of our own.
; This is the fixed part. scripts/codex-sandboxed.sh appends the write allowances, then the
; write and read denials. Rules are evaluated last-match-wins, so a deny after an allow narrows it.
(deny default)
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow sysctl-read)
(allow sysctl-write (sysctl-name "kern.grade_cputype"))
(allow iokit-open (iokit-registry-entry-class "RootDomainUserClient"))
(allow mach-lookup)
(allow ipc-posix-sem)
(allow ipc-posix-shm*)
(allow pseudo-tty)
(allow user-preference-read)
(allow system-mac-syscall)
(allow system-fsctl)
(allow system-socket)
(allow network*)
(allow file-read*)
(allow file-map-executable)
(allow file-ioctl (regex #"^/dev/ttys[0-9]+"))
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write* (regex #"^/dev/ttys[0-9]+"))
(allow file-write-data (literal "/dev/null") (literal "/dev/zero") (subpath "/dev/fd"))
